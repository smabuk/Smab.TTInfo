		<h2 class="m-3">@eventInfo.Name</h2>
	} *@
	<button class="btn btn-primary m-3" @onclick="PrintPage">Print All Match Cards</button>
</div>

<div class="print-page">
	@{
		// int noOfMatchCards = 0;
	}
	@* @foreach (EliminationInfo elimination in eliminations) {
		@foreach (MatchInfo match in elimination.Matches.OrderBy(m => m.MatchNr))
		{
			bool skip = match.PlayerADisplay == "TBD" || match.PlayerBDisplay == "TBD";
			@if (!skip)
			{
				noOfMatchCards++;
				string playerA = match.PlayerADisplay.StartsWith("Winner") ? "\u200B" : match.PlayerADisplay;
				string playerB = match.PlayerBDisplay.StartsWith("Winner") ? "\u200B" : match.PlayerBDisplay;
				playerA = match.PlayerADisplay.StartsWith("Group") ? playerA.Replace("Group ", "") : playerA;
				playerB = match.PlayerBDisplay.StartsWith("Group") ? playerB.Replace("Group ", "") : playerB;
				<MatchCard
						   Title="@tournamentService.Name"
						   HeaderLeft="@($"{eventInfo?.Name} {match.Round}")"
						   HeaderRight="@($"#{match.MatchNr}")"
						   PlayerAName="@playerA"
						   PlayerBName="@playerB"
						   IsHandicap="@elimination.IsHandicap" />
			}
		}
		@for (int match = (noOfMatchCards % 6) + 8; match >= 0; match--) {
			<MatchCard Title="@tournamentService.Name" IsHandicap="@elimination.IsHandicap" />
		} *@
	}

</div>

