@page "/print/matchcards"
@page "/print/matchcards/{NoOfRounds:int}"
@layout PrintLayout
@* @inject TournamentService tournamentService *@
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Print Match Cards</PageTitle>

@PrintHelpers.PaperInfo("A4", "portrait", 1)

