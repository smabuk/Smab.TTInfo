@page "/olop/premier/week/{WeekNo:int}"
@using OfficeOpenXml;

@inject HttpClient httpClient
@inject IOptions<OlopOptions> options
@rendermode InteractiveServer

<PageTitle>OLOP Premier Week @WeekNo</PageTitle>
<h1>OLOP Premier Week @WeekNo <span>@((Week?.Date is null ? "" : $"({Week.Date.ToOrdinalString("ddd d MMMM yyyy")})"))</span></h1>

@if (isLinked is false) {
	<p>OLOP Premier Excel link is not configured.</p>
} else if (Week is null) {
	<p>Loading ...</p>
} else if (Week.Rounds is []) {
	<p>
		No draw yet.
		@if (Week.Date is not null) {
			<text> Draw will be published on @($"{Week.Date:dd MMM yyyy}").</text>
		}
	</p>
	@if (Week.PlayerDetails is not []) {
		<h2>@Week.PlayerDetails.Count Players signed up</h2>
		@foreach (WeekPlayerDetails playerDetails in Week.PlayerDetails.OrderBy(pd => pd.Player.Name)) {
			<p>@playerDetails.Player.Name</p>
		}
	}
} else {
	@if (AnyMatchesToBePlayed(Week.Rounds)) {
		<h2>To be played</h2>

		@foreach (Round round in Week.Rounds) {
			List<Match> matches = [.. round.Matches.Where(m => (m.Player1 is NamedPlayer && m.Player2 is NamedPlayer && m.Games is []) || (m.Player1 is NoPlayer || m.Player2 is NoPlayer))];
			@if (matches is not []) {
				<h3>@round.Name</h3>
				@foreach (Match match in matches) {
					<p class="@((match.Player1 == HighlightPlayer || match.Player2 == HighlightPlayer) ? "highlight-player" : "")">@((MarkupString)MatchToHtmlString(match))</p>
				}
			}
		}
	}

	<h2>Completed</h2>
	@* @foreach (Round round in (List<Round>)[.. Rounds.OfType<MainRound>().OrderByDescending(r => r.RoundNo), .. Rounds.OfType<ConsolationRound>().OrderByDescending(r => r.RoundNo)]) { *@
	@foreach (Round round in Week.Rounds.OrderByDescending(r => r.Type.ToRoundNo())) {
		List<Match> matches = [.. round.Matches.Where(m => (m.Player1 is NamedPlayer && m.Player2 is NamedPlayer && m.Games is not []) || (m.Player1 is Bye || m.Player2 is Bye))];

		@if (matches is not []) {
			<h3>@round.Name</h3>
			@foreach (Match match in matches) {
				<p class="@((match.Player1 == HighlightPlayer || match.Player2 == HighlightPlayer) ? "highlight-player" : "")">@((MarkupString)MatchToHtmlString(match))</p>
			}
		}
	}


	<h2>Points</h2>
	<table>
		<thead>
			<tr>
				<th scope="col">
					<button class="btn" @onclick="() => SortPointsTableBy(SortableField.Name)">
						Name @SortIndicator(SortableField.Name)
					</button>
				</th>
				<th scope="col">
					<button class="btn" @onclick="() => SortPointsTableBy(SortableField.Rank)">
						Rank @SortIndicator(SortableField.Rank)
					</button>
				</th>
				<th scope="col">
					<button class="btn" @onclick="() => SortPointsTableBy(SortableField.Points)">
						Points @SortIndicator(SortableField.Points)
					</button>
				</th>
			</tr>
		</thead>
		<tbody>
			@{
				List<WeekPlayerDetails> sortedPlayers = _currentSortField switch
				{
					SortableField.Rank => [.. Week.PlayerDetails.OrderBy(pd => pd.Rank).ThenBy(pd => pd.Player.Name)],
					SortableField.Name => [.. Week.PlayerDetails.OrderBy(pd => pd.Player.Name)],
					SortableField.Points => [.. Week.PlayerDetails.OrderByDescending(pd => pd.PremierPoints).ThenBy(pd => pd.Player.Name)],
					_ => [.. Week.PlayerDetails.OrderByDescending(pd => pd.PremierPoints).ThenBy(pd => pd.Player.Name)]
				};
			}

			@foreach (WeekPlayerDetails playerDetails in sortedPlayers) {
				<tr class="@(HighlightPlayer == playerDetails.Player ? "highlight-player" : "")" @onclick="() => SetHighlightPlayer(playerDetails.Player)">
					<td>
						@playerDetails.Player.Name
						<span>
							@if (playerDetails.Player == HighlightPlayer) {
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="limegreen" class="bi bi-eye-fill" viewBox="0 0 16 16">
									<path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0" />
									<path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7" />
								</svg>
							}
						</span>
					</td>
					<td>@playerDetails.Rank</td>
					<td>@playerDetails.PremierPoints.ToString("F1")</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	[Parameter]
	public int WeekNo { get; set; }

	[PersistentState] public Week? Week { get; set; }
	[PersistentState] public bool? isLinked { get; set; } = null;

	private SortableField _currentSortField = SortableField.Points;
	private bool _sortAscending = false;
	private NamedPlayer? HighlightPlayer { get; set; } = default;

	protected override async Task OnParametersSetAsync()
	{
		isLinked = !string.IsNullOrWhiteSpace(options.Value.OlopPremierExcelLink);

		if (isLinked is true && Week is null) {
			using ExcelPackage package = await options.Value.OlopPremierExcelLink.OpenExcelPackage(httpClient);
			Week = package.GetWeek(WeekNo);
		}
	}

	private void SetHighlightPlayer(NamedPlayer? player)
	{
		if (HighlightPlayer == player) {
			HighlightPlayer = null;
		} else {
			HighlightPlayer = player;
		}
	}

	private static string MatchToHtmlString(Match match)
	{
		string htmlString = (match.Player1, match.Player2) switch
		{
			(NoPlayer, NoPlayer) => "No match",
			(NamedPlayer player1, NoPlayer) => $"<span class='player'>{player1.Name}</span> vs unknown",
			(NoPlayer, NamedPlayer player2) => $"unknown vs <span class='player'>{player2.Name}</span>",
			(NamedPlayer player1, Bye) => $"<span class='player' data-result='winner'>{player1.Name}</span> (<span class='premier-points'>{match.PremierPoints1:F1}</span>) has a bye",
			(Bye, NamedPlayer player2) => $"<span class='player' data-result='winner'>{player2.Name}</span> (<span class='premier-points'>{match.PremierPoints2:F1}</span>) has a bye",
			(Bye bye1, Bye bye2) => $"""Bye {(string.IsNullOrWhiteSpace(bye1.ByeInfo) ? "" : $" - {bye1.ByeInfo} withdrew")}""",
			_ when match.Player1IsWinner => $"""<span class='player' data-result='winner'>{match.Player1.Name}</span> (<span class='premier-points'>{match.PremierPoints1:F1}</span>) vs <span class='player' data-result='loser'>{match.Player2.Name}</span> (<span class='premier-points'>{match.PremierPoints2:F1}</span>) <span class='scores'>{string.Join(", ", match.Games.Select(g => $"{g}"))}</span>""",
			_ when match.Player2IsWinner => $"""<span class='player' data-result='loser'>{match.Player1.Name}</span> (<span class='premier-points'>{match.PremierPoints1:F1}</span>) vs <span class='player' data-result='winner'>{match.Player2.Name}</span> (<span class='premier-points'>{match.PremierPoints2:F1}</span>) <span class='scores'>{string.Join(", ", match.Games.Select(g => $"{g}"))}</span>""",
			_ => $"""<span class='player'>{match.Player1.Name}</span> vs <span class='player'>{match.Player2.Name}</span> <span class='scores'>{string.Join(", ", match.Games.Select(g => $"{g}"))}</span>""",
		};

		return $"<span>{htmlString}</span>";
	}

	private static bool AnyMatchesToBePlayed(IEnumerable<Round> rounds)
		=> rounds.Any(round => round.Matches.Any(m => (m.Player1 is NamedPlayer && m.Player2 is NamedPlayer && m.Games is []) || (m.Player1 is NoPlayer || m.Player2 is NoPlayer)));


	private void SortPointsTableBy(SortableField field)
	{
		_currentSortField = field;
		_sortAscending = field switch
		{
			SortableField.Name => true,
			SortableField.Points => false,
			SortableField.Rank => true,
			_ => !_sortAscending

		};
	}

	private RenderFragment SortIndicator(SortableField sortableField) => builder =>
	{
		if (_currentSortField == sortableField) {
			builder.OpenElement(0, "span");
			builder.AddAttribute(1, "data-sort-indicator", _sortAscending ? "asc" : "desc");
			builder.CloseElement();
		}
	};

	private enum SortableField
	{
		Name,
		Points,
		Rank,
	}


}
