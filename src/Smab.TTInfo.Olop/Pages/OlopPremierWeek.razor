@page "/olop/premier/week/{WeekNo:int}"
@using OfficeOpenXml;

@inject HttpClient httpClient
@inject IOptions<OlopOptions> options
@rendermode InteractiveServer

<PageTitle>OLOP Premier Week @WeekNo</PageTitle>
<h1>OLOP Premier Week @WeekNo</h1>


@if (isLinked is false) {
	<p>OLOP Premier Excel link is not configured.</p>
} else if (Rounds is null or []) {
	<p>Loading ...</p>
} else {
	@if (AnyMatchesToBePlayed(Rounds)) {
		<h2>To be played</h2>

		@foreach (Round round in Rounds) {
			List<Match> matches = [.. round.Matches.Where(m => (m.Player1 is NamedPlayer && m.Player2 is NamedPlayer && m.Games is []) || (m.Player1 is NoPlayer || m.Player2 is NoPlayer))];
			@if (matches is not []) {
				<h3>@round.Name</h3>
				@foreach (Match match in matches) {
					<p>@((MarkupString)MatchToHtmlString(match))</p>
				}
				<br />
			}
		}
	}

	<h2>Completed</h2>
	@* @foreach (Round round in (List<Round>)[.. Rounds.OfType<MainRound>().OrderByDescending(r => r.RoundNo), .. Rounds.OfType<ConsolationRound>().OrderByDescending(r => r.RoundNo)]) { *@
	@foreach (Round round in Rounds.OrderByDescending(r => r.RoundNo)) {
		List<Match> matches = [.. round.Matches.Where(m => (m.Player1 is NamedPlayer && m.Player2 is NamedPlayer && m.Games is not []) || (m.Player1 is Bye || m.Player2 is Bye))];

		@if (matches is not []) {
			<h3>@round.Name</h3>
			@foreach (Match match in matches) {
				<p>@((MarkupString)MatchToHtmlString(match))</p>
			}
			<br />
		}
	}
}

@code {
	[Parameter]
	public int? WeekNo { get; set; }

	[PersistentState]
	public List<SummaryTable>? summaryTable { get; set; }
	[PersistentState]
	public List<WeekDates>? weekDates { get; set; }
	[PersistentState]
	public List<Round>? Rounds { get; set; }
	[PersistentState]
	public bool? isLinked { get; set; } = null;

	protected override async Task OnParametersSetAsync()
	{
		if (summaryTable is null or []) {
			string url = options.Value.OlopPremierExcelLink;

			if (string.IsNullOrWhiteSpace(url)) {
				isLinked = false;
				return;
			}

			isLinked = true;
			using ExcelPackage package = await url.OpenExcelPackage(httpClient);
			//summaryTable = [.. package.GetSummaryData()];
			weekDates = [.. package.GetWeekDates()];
			Rounds = [.. package.GetRoundsForWeek(WeekNo ?? 1)];

		}
	}


	private static string MatchToHtmlString(Match match)
	{
		string htmlString = "";

		htmlString = (match.Player1, match.Player2) switch
		{
			(NoPlayer, NoPlayer) => "No match",
			(NamedPlayer player1, NoPlayer) => $"<span class='player'>{player1.Name}</span> vs unknown",
			(NoPlayer, NamedPlayer player2) => $"unknown vs <span class='player'>{player2.Name}</span>",
			(NamedPlayer player1, Bye) => $"<span class='player' data-result='winner'>{player1.Name}</span> (<span class='premier-points'>{match.PremierPoints1:F1}</span>) has a bye",
			(Bye, NamedPlayer player2) => $"<span class='player' data-result='winner'>{player2.Name}</span> (<span class='premier-points'>{match.PremierPoints2:F1}</span>) has a bye",
			(Bye, Bye) => "Bye",
			_ => $"<span class='player' data-result='{(match.Player1IsWinner ? "winner" : match.Player2IsWinner ? "loser" : null)}'>{match.Player1.Name}</span> (<span class='premier-points'>{match.PremierPoints1:F1}</span>) vs <span class='player' data-result='{(match.Player2IsWinner ? "winner" : match.Player1IsWinner ? "loser" : null)}'>{match.Player2.Name}</span> (<span class='premier-points'>{match.PremierPoints2:F1}</span>): {string.Join(", ", match.Games.Select(g => $"{g}"))}"
		};

		return $"<span>{htmlString}</span>";
	}

	private static bool AnyMatchesToBePlayed(IEnumerable<Round> rounds)
	{
		return rounds.Any(round => round.Matches.Any(m => (m.Player1 is NamedPlayer && m.Player2 is NamedPlayer && m.Games is []) || (m.Player1 is NoPlayer || m.Player2 is NoPlayer)));
	}

}
