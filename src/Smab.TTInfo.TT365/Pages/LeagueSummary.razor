@page "/LeagueSummary/{LeagueId}"
@page "/LeagueSummary/{LeagueId}/{SeasonId}"
@inject ITT365Reader _tt365
@attribute [StreamRendering]

@if (isLoading) {
	string leagueName = League?.Name ?? leagueId;
	<PageTitle>@leagueName - @SeasonId</PageTitle>
	<h1>@leagueName</h1>
	<h2>Loading ... @SeasonId ...</h2>
}

@if (League is not null && Season is not null) {
	<PageTitle>@League.Name @Season.Name</PageTitle>
	<h1>@League.Name @Season.Name</h1>
	<div>
		@foreach (Division division in Season.Divisions) {
			<DivisionSummary Division="@division" LeagueId="@League.Id" SeasonId="@Season.Id" />
		}
	</div>
	<br />
	<dl>
		<dt>Name</dt>
		<dd>@League.Name</dd>
		<dt>Description</dt>
		<dd>@League.Description</dd>
		<dt>URL</dt>
		<dd><a href="@League.URL" target="_blank">@League.URL</a></dd>
		<dt>Theme</dt>
		<dd>@League.Theme</dd>
		<dt>Current Season</dt>
		<dd>
			<a href="/LeagueSummary/@LeagueId/@League.CurrentSeason.Id">@League.CurrentSeason.Name</a>
			@*
			@if (seasons.Any()) {
				<select @bind="SeasonId">
					@foreach (string seasonName in seasons.Select(s => s.Name)) {
						<option value="@seasonName">@seasonName</option>
					}
				</select>
			} else {
				<text>No seasons defined yet</text>
			}
			*@
		</dd>
		<dt>Previous Seasons</dt>
		<dd>
			@foreach ((int index, Season season) in League.Seasons.Where(s => s.Id != League.CurrentSeason.Id).OrderByDescending(s => s.Id).Index()) {
				<a href="/LeagueSummary/@LeagueId/@season.Id">@(index == 0 ? "" : ", ")@season.Name</a>
			}
		</dd>
	</dl>
}
