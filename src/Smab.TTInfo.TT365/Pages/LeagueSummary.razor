@page "/LeagueSummary/{LeagueId}"
@page "/LeagueSummary/{LeagueId}/{SeasonId}"
@inject ITT365Reader _tt365
@attribute [StreamRendering]

<PageTitle>@LeagueName</PageTitle>


@if (isLoading) {
	<PageTitle>@LeagueName - @SeasonId</PageTitle>
	<h1>@LeagueName</h1>
	<h2>Loading ... @SeasonId ...</h2>
}

@if (League is not null && divisions.Any()) {
	<h1>@LeagueName @SeasonId</h1>
	<div>
		@foreach (Division division in divisions) {
			<DivisionSummary Division="@division" LeagueId="@League.Id" SeasonId="@SeasonId" />
		}
	</div>
	<br />
	<dl>
		<dt>Name</dt>
		<dd>@League.Name</dd>
		<dt>Description</dt>
		<dd>@League.Description</dd>
		<dt>URL</dt>
		<dd><a href="@League.URL" target="_blank">@League.URL</a></dd>
		<dt>Theme</dt>
		<dd>@League.Theme</dd>
		<dt>Current Season</dt>
		<dd>
			<a href="/LeagueSummary/@LeagueId/@@League.CurrentSeason.Name"><span>@League.CurrentSeason.Name</span></a>
			@* @if (seasons.Any()) {
				<select @bind="SeasonId">
					@foreach (string seasonName in seasons.Select(s => s.Name)) {
						<option value="@seasonName">@seasonName</option>
					}
				</select>
			} else {
				<text>No seasons defined yet</text>
			}
 *@
		</dd>
		<dt>Previous Seasons</dt>
		<dd>
			@foreach ((int index, Season season) in League.Seasons.Where(s => s.Name != League.CurrentSeason.Name).OrderByDescending(s => s.Id).Index()) {
				<a href="/LeagueSummary/@LeagueId/@season.Name">@(index == 0 ? "" : ", ")@season.Name</a>
			}
		</dd>
	</dl>
}
