@page "/PlayerSummary/{LeagueId}/{PlayerName}"
@page "/PlayerSummary/{LeagueId}/{PlayerName}/{PlayerId:int}"
@page "/PlayerSummary/{LeagueId}/{SeasonName}/{PlayerName}/{PlayerId:int}"
@inject ITT365Reader _tt365
@attribute [StreamRendering]

@{string playerName = PlayerName.Replace("_", " ");}
<h1>
	Player Stats for @playerName
	@if (PlayerId is not null)
	{
		<a class="badge" href="PlayerSummary/@LeagueId/@PlayerName">Historical results</a>
	}
</h1>

@if (isLoading) {
	<PageTitle>@playerName - @LeagueId</PageTitle>
	<h2>Loading ... @playerName ...</h2>
}

@if (playerResults.Count == 0 && !isLoading) {
	<PageTitle>@playerName - @league?.Name</PageTitle>
	<h2>@league?.Name @SeasonName.Replace("_", " ")</h2>
	<p>No results found.</p>
} else {
	<PageTitle>@playerName - @league?.Name</PageTitle>
	@foreach (string seasonName in playerResults.Keys.OrderDescending())
	{
		List<PlayerResult> seasonPlayerResults = playerResults[seasonName];
		List<string> playerTeams = [.. seasonPlayerResults
			.GroupBy(p => p.PlayerTeamName)
			.OrderByDescending(g => g.Count())
			.Select(g => g.Key)];

		<div id="results">
			<h2>@league?.Name @seasonName.Replace("_", " ")</h2>
			@foreach (string teamName in playerTeams) {
				List<PlayerResult> results = [.. seasonPlayerResults
					.Where(p => p.PlayerTeamName == teamName)
					.OrderByDescending(p => p.Date)
					.ThenByDescending(p => p.OriginalSortOrder)
					];
				<h3><a href="TeamSummary/@LeagueId/@seasonName/@teamName">@teamName</a> - <a href="/DivisionSummary/@LeagueId/@seasonName/@results[0].Division">@results[0].Division.Replace("_", " ")</a></h3>
				<table class="table table-bordered table-sm">
					<thead>
						<tr>
							<th>Opponent</th>
							<th>Team</th>
							<th>Date</th>
							<th>Games</th>
							<th>Score</th>
							@* <th>Ranking</th> *@
						</tr>
					</thead>
					<tbody>
						@foreach (PlayerResult result in results) {
							<tr data-result='@result.Result.ToLower()'>
								<td><a href="PlayerSummary/@LeagueId/@seasonName/@result.Opponent.Name.Replace(" ", "_")/@result.Opponent.Id">@result.Opponent.Name</a></td>
								<td><a href="TeamSummary/@LeagueId/@seasonName/@result.OpponentTeam">@result.OpponentTeam</a></td>
								<td>@result.Date.ToString("dd MMM yyyy")</td>
								<td><a href="@result.MatchCardURL" target="_blank" rel="noopener">@result.GameScore</a></td>
								<td>@result.Scores.Replace(",",", ")</td>
								@* <td>@result.FormattedRankingDiff</td> *@
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
	<div id="summary">
		<h2>Summary</h2>
		<table class="table table-bordered table-sm">
			<thead>
				<tr>
					<th>Season</th>
					<th>Div</th>
					<th>Team</th>
					<th>Played</th>
					<th>Won</th>
					<th>Lost</th>
					<th>Win %</th>
					@* <th>Rank Pts</th> *@
				</tr>
			</thead>
			<tbody>
				@foreach (string seasonName in playerResults.Keys.OrderDescending()) {
					List<PlayerResult> seasonPlayerResults = playerResults[seasonName];
					List<string> playerTeams = [.. seasonPlayerResults
						.GroupBy(p => p.PlayerTeamName)
						.OrderByDescending(g => g.Count())
						.Select(g => g.Key)];
					int teamsCount = playerResults[seasonName].GroupBy(p => p.PlayerTeamName).Count();
					<tr data-row="summary">
						@if (teamsCount == 1)
						{
							<td>@seasonName.Replace("_", " ")</td>
							string teamName = seasonPlayerResults.First().PlayerTeamName;
							<td>@seasonPlayerResults.First().Division.Replace("Division_", "")</td>
							<td><a href="TeamSummary/@LeagueId/@seasonName/@teamName">@teamName</a></td>
						} else {
							<td colspan="3">@seasonName.Replace("_", " ")</td>
						}
						<td>@seasonPlayerResults.Count</td>
						<td>@seasonPlayerResults.Where(r => r.Result == "Win").Count()</td>
						<td>@(seasonPlayerResults.Count - seasonPlayerResults.Where(r => r.Result == "Win").Count())</td>
						<td>@($"{(seasonPlayerResults.Where(r => r.Result == "Win").Count() * 100 / seasonPlayerResults.Count)}%")</td>
					</tr>
					@if (teamsCount > 1) {
						@foreach (string teamName in playerTeams) {
							List<PlayerResult> teamPlayerResults = [.. seasonPlayerResults.Where(s => s.PlayerTeamName == teamName)];
							<tr>
								<td>&nbsp;</td>
								<td>@teamPlayerResults.First().Division.Replace("Division_", "")</td>
								<td><a href="TeamSummary/@LeagueId/@seasonName/@teamName">@teamName</a></td>
								<td>@teamPlayerResults.Count</td>
								<td>@teamPlayerResults.Where(r => r.Result == "Win").Count()</td>
								<td>@(teamPlayerResults.Count - teamPlayerResults.Where(r => r.Result == "Win").Count())</td>
								<td>@($"{(teamPlayerResults.Where(r => r.Result == "Win").Count() * 100 / teamPlayerResults.Count)}%")</td>
							</tr>
						}
					}
				}
			</tbody>
			<tfoot>
			</tfoot>
		</table>
	</div>
}
